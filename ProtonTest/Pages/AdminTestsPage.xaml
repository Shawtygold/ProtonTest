<Page x:Class="ProtonTest.Pages.AdminTestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProtonTest.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminTestsPage">
    <Page.Resources>
        <local:BoolToStringConverter x:Key="BoolToStringConverter"/>

        <Style TargetType="Button" x:Key="OutlineButtonStyle" BasedOn="{StaticResource CleanButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <Button Name="BackToggleBtn" Content="Назад" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource OutlineButtonStyle}" Click="BackToggleBtn_Click" Padding="12,6"/>
                <TextBlock Text="Управление тестированием" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Создание и настройка тестов, вопросов и вариантов ответов" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Блок 1: Управление тестами -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список тестов -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="1. Список тестов" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <ListBox Name="TestsListBox" Height="220" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="TestsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Форма теста -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Name="TestFormTitle" Text="Добавить / Редактировать тест" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Департамент" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Name="AdminDepartmentCombo" Height="36" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8"/>

                        <TextBlock Text="Название теста" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Name="TestTitleBox" Height="34" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,0,0,8"/>

                        <TextBlock Text="Описание" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Name="TestDescBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,4" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить тест" Style="{StaticResource CleanButtonStyle}" Click="SaveTest_Click" Margin="0,0,8,0" Height="32" Cursor="Hand" Padding="10,4"/>
                            <Button Content="Удалить" Style="{StaticResource CleanButtonStyle}" Background="#FFE81123" Foreground="White" BorderThickness="0" Click="DeleteTest_Click" Cursor="Hand" Padding="10,4" Margin="0,0,8,0" Height="32"/>
                            <Button Content="Очистить" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="ClearTestForm_Click" Cursor="Hand" Height="32"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Блок 2: Управление вопросами и ответами (доступно при выборе теста) -->
            <Border Grid.Row="2" Name="QuestionsSection" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" IsEnabled="False" Opacity="0.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список вопросов -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="2. Вопросы выбранного теста" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <ListBox Name="QuestionsListBox" Height="250" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="QuestionsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Добавить вопрос" Style="{StaticResource CleanButtonStyle}" Click="NewQuestion_Click" Margin="0,0,8,0" Cursor="Hand" Padding="10,4" Height="32"/>
                            <Button Content="Удалить вопрос" Style="{StaticResource CleanButtonStyle}" Background="#FFE81123" Foreground="White" BorderThickness="0" Click="DeleteQuestion_Click" Cursor="Hand" Padding="10,4" Height="32"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Редактирование вопроса и список вариантов ответов -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="3. Текст вопроса и варианты ответов" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Текст вопроса" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Name="QuestionTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,4" Margin="0,0,0,8"/>
                        <Button Content="Сохранить текст вопроса" Cursor="Hand" Padding="10,4" Style="{StaticResource CleanButtonStyle}" Click="SaveQuestionText_Click" Margin="0,0,0,16" Height="30" HorizontalAlignment="Left"/>

                        <!-- Варианты ответов -->
                        <TextBlock Text="Варианты ответа (отметьте правильный)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ListBox Name="OptionsListBox" Height="130" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OptionText}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IsCorrect, Converter={StaticResource BoolToStringConverter}}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                        <Button Grid.Column="2" Content="Удалить" Background="#FFE81123" Foreground="White" BorderThickness="0" Tag="{Binding}" Click="DeleteOption_Click" Cursor="Hand" Padding="6,2" Height="24"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Добавление нового варианта ответа -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="NewOptionTextBox" Height="32" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Name="IsCorrectCheckBox" Content="Правильный" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Добавить" Style="{StaticResource CleanButtonStyle}" Click="AddOption_Click" Height="32" Cursor="Hand" Padding="10,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
