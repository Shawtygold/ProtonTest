<Page x:Class="ProtonTest.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProtonTest.Pages"
      mc:Ignorable="d" 
      Title="LoginPage">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="32">
            <StackPanel>
                <TextBlock Name="TitleText" Text="Вход в систему" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24" HorizontalAlignment="Center"/>

                <TextBlock Text="Логин / Табельный номер" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Name="UsernameBox" Height="40" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,16"/>

                <TextBlock Name="FullNameLabel" Text="ФИО сотрудника" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>
                <TextBox Name="FullNameBox" Height="40" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,16" Visibility="Collapsed"/>

                <Button Name="SubmitBtn" Content="Войти" Style="{StaticResource CleanButtonStyle}" Click="Submit_Click" Margin="0,8,0,12" Height="40"/>

                <Button Name="SwitchModeBtn" Content="Нет аккаунта? Зарегистрироваться" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Click="SwitchMode_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
